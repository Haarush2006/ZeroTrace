# Set PUBLIC_ADDRESS=chat.example.com in production. Caddy then provisions a
# TLS certificate automatically and serves HTTP/2 + WebSocket over the same port.
# The default serves plain HTTP on localhost.
{$PUBLIC_ADDRESS:http://localhost} {
	encode zstd gzip

	@backend path /ws /health
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
}
