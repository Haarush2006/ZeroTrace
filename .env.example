# Docker Compose configuration. Copy to .env and edit before deploying.

# Local HTTP default. Use "chat.example.com" for automatic HTTPS with Caddy.
PUBLIC_ADDRESS=http://localhost

# Origin the backend accepts WebSocket upgrades from (scheme + host, no path).
# For production: https://chat.example.com
PUBLIC_ORIGIN=http://localhost

# WebSocket URL inlined into the frontend build. Must match PUBLIC_ORIGIN.
# For production: wss://chat.example.com/ws
PUBLIC_WS_URL=ws://localhost/ws

# Room lifecycle
ROOM_TTL_MS=1800000
ROOM_EMPTY_GRACE_MS=120000

# Capacity
MAX_ROOMS=5000
MAX_USERS_PER_ROOM=50
MAX_MESSAGES_PER_ROOM=500
