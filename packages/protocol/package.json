{
  "name": "@chat/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Wire protocol shared by the ephemeral chat backend and frontend",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "typesVersions": {
    "*": {
      "schemas": ["./dist/schemas.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
