{
  "name": "roomsbackend",
  "version": "1.0.0",
  "description": "Ephemeral WebSocket chat rooms that self-destruct after inactivity",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc -b && node --env-file-if-exists=.env ./dist/index.js",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@chat/protocol": "0.1.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
