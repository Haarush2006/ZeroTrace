# Copy to .env and run with: node --env-file-if-exists=.env ./dist/index.js

PORT=8080

# Enable only behind a private proxy that overwrites X-Real-IP (Compose does this).
TRUST_PROXY=0

# Idle time before a room is destroyed (30 minutes).
ROOM_TTL_MS=1800000

# Once the last member leaves, the room dies within this window (2 minutes).
ROOM_EMPTY_GRACE_MS=120000

MAX_ROOMS=5000
MAX_MESSAGES_PER_ROOM=500
MAX_USERS_PER_ROOM=50

# Largest accepted WebSocket frame (16 KiB).
MAX_PAYLOAD_BYTES=16384

HEARTBEAT_MS=30000
SWEEP_MS=15000

# Comma-separated. Requests from other origins are rejected.
ALLOWED_ORIGINS=http://localhost:3000
